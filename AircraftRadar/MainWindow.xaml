<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AircraftRadar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircraftRadar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AircraftRadar">

    <Grid x:Name="RadarHost" SizeChanged="RadarHost_SizeChanged" Background="#FF07090C">
        <!-- Layer 1: static background. Built once in code-behind and recentred on resize. -->
        <Canvas x:Name="BackgroundLayer" IsHitTestVisible="False" />

        <!-- Layer 2: aircraft. -->
        <local:CanvasItemsControl
            x:Name="AircraftLayer"
            ItemsSource="{x:Bind ViewModel.Aircraft}"
            IsHitTestVisible="False">

            <local:CanvasItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </local:CanvasItemsControl.ItemsPanel>


            <local:CanvasItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AircraftViewModel">
                    <!--
                        The container is positioned at the aircraft; this Canvas's origin is
                        therefore the aircraft's exact position, and the symbol's parts hang off
                        it at negative and positive offsets. Sized 1x1 rather than left at zero
                        so the container is arranged with a real rect; Canvas does not clip, so
                        the parts still draw outside it.
                    -->
                    <Canvas Width="1" Height="1">
                        <!-- History trail underneath everything else. -->
                        <local:CanvasItemsControl
                            Width="1" Height="1"
                            ItemsSource="{x:Bind Trail}"
                            IsHitTestVisible="False">
                            <local:CanvasItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </local:CanvasItemsControl.ItemsPanel>
                            <local:CanvasItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TrailDotViewModel">
                                    <Canvas Width="1" Height="1">
                                        <Ellipse
                                            Canvas.Left="-1.5" Canvas.Top="-1.5"
                                            Width="3" Height="3"
                                            Fill="{x:Bind DotBrush, Mode=OneWay}"
                                            Opacity="{x:Bind Opacity, Mode=OneWay}" />
                                    </Canvas>
                                </DataTemplate>
                            </local:CanvasItemsControl.ItemTemplate>
                        </local:CanvasItemsControl>

                        <!-- Speed vector, so the diamond sits on top of its tail. -->
                        <Line
                            X1="0" Y1="0"
                            X2="{x:Bind VectorEndX, Mode=OneWay}"
                            Y2="{x:Bind VectorEndY, Mode=OneWay}"
                            Stroke="{x:Bind SymbolBrush, Mode=OneWay}"
                            StrokeThickness="1.25"
                            Visibility="{x:Bind VectorVisibility, Mode=OneWay}" />
                        <Polygon
                            Canvas.Left="-4" Canvas.Top="-4"
                            Points="4,0 8,4 4,8 0,4"
                            Fill="{x:Bind SymbolBrush, Mode=OneWay}" />

                        <!-- Leader line, from the diamond's upper-right edge to the block. -->
                        <Line
                            X1="5" Y1="-5" X2="17" Y2="-17"
                            Stroke="{x:Bind SymbolBrush, Mode=OneWay}"
                            StrokeThickness="0.75"
                            Opacity="0.65" />

                        <StackPanel Canvas.Left="19" Canvas.Top="-34">
                            <TextBlock
                                Text="{x:Bind Callsign, Mode=OneWay}"
                                FontFamily="Consolas" FontSize="11"
                                Foreground="{x:Bind SymbolBrush, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind DataBlockDetail, Mode=OneWay}"
                                FontFamily="Consolas" FontSize="10"
                                Foreground="{x:Bind SymbolBrush, Mode=OneWay}"
                                Opacity="0.85" />
                        </StackPanel>
                    </Canvas>
                </DataTemplate>
            </local:CanvasItemsControl.ItemTemplate>
        </local:CanvasItemsControl>

        <!-- Layer 3: overlay. -->
        <StackPanel Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="2">
            <TextBlock Text="STANSTED 51.885N 000.235E"
                       FontFamily="Consolas" FontSize="12" Foreground="#FF4A5B6E" />
            <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#FFB9C7D6">
                <Run Text="{x:Bind ViewModel.VisibleCount, Mode=OneWay}" />
                <Run Text=" shown /" />
                <Run Text="{x:Bind ViewModel.TrackedCount, Mode=OneWay}" />
                <Run Text=" tracked" />
            </TextBlock>
            <TextBlock x:Name="RangeText" FontFamily="Consolas" FontSize="12" Foreground="#FF4A5B6E" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontFamily="Consolas" FontSize="12" Foreground="#FF7FA0BF" />
        </StackPanel>
    </Grid>
</Window>
